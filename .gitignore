# ==============================================================================
# Root .gitignore — Ketsai Project
# Hanya folder backend dan frontend yang dilacak untuk menjalankan project.
# Folder lainnya (seperti .agent, IDE config, OS files, secrets) diabaikan.
# ==============================================================================

# Agent & AI Artifacts / Tooling
.agent/
.agents/
.gemini/

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secret Credentials (Sangat rahasia)
.env
.env.*
*.local
backend/.env
frontend/.env
!backend/.env.example
!frontend/.env.example
!.env.example

# Dependencies & Package Manager
node_modules/
package-lock.json.bak
yarn.lock.bak
pnpm-lock.yaml.bak

# Build & Compiled Output
dist/
dist-ssr/
build/
out/
coverage/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary & Cache Dirs
.cache/
.temp/
tmp/
temp/

# Berkas Dokumentasi & Konfigurasi Git (Abaikan pelacakan git)
DOCUMENTATION.md
documentation.md
.gitignore
